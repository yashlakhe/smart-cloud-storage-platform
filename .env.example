# Database Configuration
# For host local dev: postgresql+psycopg://postgres:postgres@localhost:5432/smartcloudstorage
# For Docker Compose: postgresql+psycopg://postgres:postgres@db:5432/smartcloudstorage
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smartcloudstorage

# AWS S3 Configuration (Optional for initial infrastructure startup)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173

# Frontend Configuration
VITE_API_URL=http://localhost:8000
